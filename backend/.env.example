APP_NAME=Axogram API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=axogram
POSTGRES_PASSWORD=axogram
POSTGRES_DB=axogram
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173,http://localhost
FIRST_SUPERUSER=admin
FIRST_SUPERUSER_PASSWORD=Admin123!
FIRST_SUPERUSER_FULL_NAME=Administrator
STORAGE_ROOT=backend/storage

# Optional fallback for the platform-wide Telegram credentials.
# Preferred way: set them from the admin panel (لوحة الإدارة → 🔑 API تيليجرام),
# which stores them encrypted in the DB and overrides these values.
# TELETHON_API_ID=
# TELETHON_API_HASH=
